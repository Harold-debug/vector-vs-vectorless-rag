AWS_PROFILE=company-bedrock
# Bedrock region (SSO/IAM Identity Center stays eu-west-1)
AWS_REGION=us-west-2

BEDROCK_CHAT_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Required under Documents/iCloud: editable .pth files get UF_HIDDEN and Python 3.13 skips them.
UV_NO_EDITABLE=1
